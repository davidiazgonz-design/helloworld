pipeline {
    agent none 

    stages {
        stage('Get Code') {
            agent { label 'principal' }
            steps {
                cleanWs()
                git url: 'https://github.com/davidiazgonz-design/helloworld.git', branch: 'master'
                stash includes: '**', name: 'source-code'
            }
        }

        stage('Distributed Tests') {
            parallel {
               stage('Static & Security Analysis') {
                    agent { label 'agente2' }
                    steps {
                        unstash 'source-code'
                        bat 'whoami & hostname & echo %WORKSPACE%'
                        
                        
                        bat '''
                            if not exist "target" mkdir "target"
                            "C:\\Users\\donpa\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" -m flake8 --exit-zero --format=pylint app > target\\flake8.out
                        '''
                        recordIssues tools: [flake8(name: 'Flake8', pattern: 'target/flake8.out')],
                                     qualityGates: [[threshold: 8, type: 'TOTAL', unstable: true]]

                       
                        bat '''
                            "C:\\Users\\donpa\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" -m bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                        '''
                        recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')], 
                                     qualityGates: [[threshold: 1, type: 'TOTAL', unstable: true]]
                    }
                }

                
                stage('Unit, Coverage & Performance') {
                    agent { label 'agente1' }
                    steps {
                        unstash 'source-code'
                        bat 'whoami & hostname & echo %WORKSPACE%'

                       
                        bat '''
                            set PYTHONPATH=%WORKSPACE%
                            pytest --junitxml=result-unit.xml test\\unit
                            coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
                            coverage xml
                        '''
                        junit 'result*.xml'
                        recordCoverage qualityGates: [[integerThreshold: 85, metric: 'LINE', threshold: 85.0]], 
                                       tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']]

                       
                        bat '''
                            set PYTHONPATH=%WORKSPACE%
                            set FLASK_APP=app:app
                            
                            if not exist "C:\\jmeter_results" mkdir "C:\\jmeter_results"
                            if exist "C:\\jmeter_results\\results.jtl" del /f /q "C:\\jmeter_results\\results.jtl"

                            start "FlaskServer" /B "C:\\Users\\donpa\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" -m flask run --host=127.0.0.1 --port=5000
                            ping 127.0.0.1 -n 10 > nul
                            
                            cd /D "C:\\Users\\donpa\\Downloads\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3\\bin"
                            call jmeter.bat -n -t "%WORKSPACE%\\test\\jmeter\\flask.jmx" -l "C:\\jmeter_results\\results.jtl"
                            
                            taskkill /F /FI "WINDOWTITLE eq FlaskServer*" /T || echo "Servidor no activo"
                        '''
                        perfReport sourceDataFiles: 'C:/jmeter_results/results.jtl'
                    }
                }
            }
        }
    }

    post {
        always {
           
            node('agente1') { cleanWs() }
            node('agente2') { cleanWs() }
        }
    }
}
